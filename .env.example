# app
NEXT_PUBLIC_APP_URL = "http://localhost:3000"
NEXT_PUBLIC_APP_NAME = "Life Ledger"
NEXT_PUBLIC_APP_DESCRIPTION = "A year-by-year household cash-flow calculator for long-term life planning."
NEXT_PUBLIC_APP_LOGO = "/logo.png"
NEXT_PUBLIC_APP_PREVIEW_IMAGE = "/preview.png"
NEXT_PUBLIC_DEFAULT_LOCALE = "zh"

# theme
NEXT_PUBLIC_THEME = "default"

# appearance
NEXT_PUBLIC_APPEARANCE = "system"

# database
DATABASE_PROVIDER = "postgresql"
DATABASE_URL = ""
DB_SINGLETON_ENABLED = "true"
DB_MAX_CONNECTIONS = "1"

# auth secret
# openssl rand -base64 32
AUTH_SECRET = ""

# Optional: enables free-form Planning Agent reasoning. Without these values,
# the product remains runnable with a deterministic local fallback.
DEEPSEEK_API_KEY = ""
DEEPSEEK_MODEL = "deepseek-flash"
DEEPSEEK_AGENT_TIMEOUT_MS = "5000"
DEEPSEEK_PERCEPTION_TIMEOUT_MS = "4000"
DEEPSEEK_PLANNER_TIMEOUT_MS = "5000"
DEEPSEEK_AGENT_COOLDOWN_MS = "60000"
AGENT_RATE_LIMIT_INTERVAL_MS = "2500"

# Optional remote MCP endpoint for city-cost candidates. When empty, the app
# runs an in-process MCP server backed by an explicitly labelled demo dataset.
CITY_DATA_MCP_URL = ""
